# ─────────────────────────────────────────────
#  TrustChain Backend — Environment Variables
#  Copy this file to .env and fill in your values
#  NEVER commit .env to GitHub
# ─────────────────────────────────────────────

# ── APP ──────────────────────────────────────
APP_NAME=TrustChain
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
DEBUG=True

# ── SECURITY (JWT) ───────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_super_secret_key_change_this_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── MONGODB ATLAS ────────────────────────────
# Get from: https://cloud.mongodb.com
# Format:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URL=mongodb+srv://your_user:your_password@cluster0.xxxxx.mongodb.net/trustchain?retryWrites=true&w=majority
DATABASE_NAME=trustchain

# ── REDIS ────────────────────────────────────
# Local Redis:  redis://localhost:6379
# Redis Cloud:  redis://:password@host:port
REDIS_URL=redis://localhost:6379

# ── SQUAD API ────────────────────────────────
# Get from: https://sandbox.squadco.com → Merchant Settings → API & Webhook
# Use sandbox keys for development, live keys for production
SQUAD_SECRET_KEY=sandbox_sk_your_key_here
SQUAD_PUBLIC_KEY=sandbox_pk_your_key_here
SQUAD_MERCHANT_ID=your_merchant_id_here
SQUAD_BASE_URL=https://sandbox-api-d.squadco.com
# Webhook secret — set this in your Squad dashboard too
SQUAD_WEBHOOK_SECRET=your_webhook_secret_here

# ── BIOMETRIC ENGINE ─────────────────────────
# Score threshold — sessions below this are BLOCKED
BEHAVIORAL_SCORE_THRESHOLD=70
# Sessions needed before full profile scoring activates
ENROLLMENT_SESSIONS_REQUIRED=3
# Max sessions to keep in rolling profile window
MAX_PROFILE_VECTORS=50

# ── ALERTS ───────────────────────────────────
# Optional: email alerts for blocked sessions
# Leave blank to disable
ALERT_EMAIL=your_email@gmail.com
